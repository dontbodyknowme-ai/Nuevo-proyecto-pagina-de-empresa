{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--isolated",
          "--viewport=1280x800",
          "--no-usage-statistics",
          "--no-performance-crux",
          "--redact-network-headers",
          "--screenshot-format=webp",
          "--screenshot-max-width=1280"
        ]
      }
    }
  }
}
